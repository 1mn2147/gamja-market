{
  "name": "@gamja/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@gamja/contracts": "workspace:*",
    "@gamja/database": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "bullmq": "^5.0.0",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0-dev.20260715",
    "vitest": "^3.2.0"
  }
}
