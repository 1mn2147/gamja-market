generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum UserRole {
  USER
  SUPER_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum VerificationPurpose {
  CONTACT_VERIFICATION
  PASSWORD_RESET
}

enum ProductStatus {
  ACTIVE
  RESERVED
  SOLD
  HIDDEN
  DELETED
}

enum ReportTargetType {
  USER
  PRODUCT
  MESSAGE
}

enum ReportStatus {
  RECEIVED
  REVIEWING
  RESOLVED
  DISMISSED
}

enum TradeStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  DELIVERED
  CONFIRMED
  DISPUTED
  CANCELLED
}

enum PaymentStatus {
  READY
  APPROVED
  UNCONFIRMED
  FAILED
  CANCEL_PENDING
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum SettlementStatus {
  HOLD
  PAUSED
  READY
  SANDBOX_SETTLED
}

enum PaymentAction {
  CREATE_ORDER
  CONFIRM
  CANCEL
  REFUND
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum LedgerEntryType {
  ESCROW_CAPTURE
  CANCELLATION
  REFUND
  SETTLEMENT
  ADJUSTMENT
}

model User {
  id                String        @id @default(cuid())
  email             String?       @unique
  phone             String?       @unique
  passwordHash      String
  role              UserRole      @default(USER)
  status            UserStatus    @default(PENDING)
  isAdult           Boolean       @default(false)
  contactVerifiedAt DateTime?
  withdrawnAt       DateTime?
  retentionUntil    DateTime?
  neighborhoodId    String?
  neighborhood      Neighborhood? @relation(fields: [neighborhoodId], references: [id])
  sessions          Session[]
  verificationCodes VerificationCode[]
  products          Product[]
  chatRoomsAsBuyer  ChatRoom[]        @relation("ChatBuyer")
  chatRoomsAsSeller ChatRoom[]        @relation("ChatSeller")
  chatMemberships   ChatParticipant[]
  authoredMessages  ChatMessage[]     @relation("MessageAuthor")
  blockedUsers      Block[]           @relation("Blocker")
  blockedBy         Block[]           @relation("Blocked")
  reports           Report[]
  tradesAsBuyer     Trade[]           @relation("TradeBuyer")
  tradesAsSeller    Trade[]           @relation("TradeSeller")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
  @@index([neighborhoodId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model VerificationCode {
  id         String              @id @default(cuid())
  userId     String?
  identifier String
  purpose    VerificationPurpose
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int                 @default(0)
  createdAt  DateTime            @default(now())
  user       User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, purpose, expiresAt])
  @@index([userId, purpose, expiresAt])
}

model LoginThrottle {
  id             String    @id @default(cuid())
  identifierHash String    @unique
  failedCount    Int       @default(0)
  firstFailedAt  DateTime  @default(now())
  lockedUntil    DateTime?
  updatedAt      DateTime  @updatedAt
}

model Neighborhood {
  id            String             @id @default(cuid())
  code          String             @unique
  name          String
  users         User[]
  products      Product[]
  neighborsFrom NeighborhoodLink[] @relation("NeighborhoodFrom")
  neighborsTo   NeighborhoodLink[] @relation("NeighborhoodTo")
  createdAt     DateTime           @default(now())
}

model NeighborhoodLink {
  fromId    String
  toId      String
  from      Neighborhood @relation("NeighborhoodFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        Neighborhood @relation("NeighborhoodTo", fields: [toId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@id([fromId, toId])
  @@index([toId])
}

model Product {
  id             String        @id @default(cuid())
  authorId       String
  title          String
  description    String
  priceKrw       BigInt
  category       String
  neighborhoodId String
  status         ProductStatus @default(ACTIVE)
  images         ProductImage[]
  chatRooms      ChatRoom[]
  trades         Trade[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  author         User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  neighborhood   Neighborhood  @relation(fields: [neighborhoodId], references: [id], onDelete: Restrict)

  @@index([authorId, createdAt])
  @@index([neighborhoodId, status, createdAt])
  @@index([status, createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  mimeType  String
  byteSize  Int
  altText   String
  data      Bytes
  position  Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@index([productId])
}

model OutboxEvent {
  id            String      @id @default(cuid())
  type          String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(PENDING)
  occurredAt    DateTime    @default(now())
  processedAt   DateTime?

  @@index([status, occurredAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  targetType  String
  targetId    String
  reason      String?
  before      Json?
  after       Json?
  requestId   String
  occurredAt  DateTime @default(now())

  @@index([targetType, targetId, occurredAt])
}

model LedgerEntry {
  id            String          @id @default(cuid())
  transactionId String
  paymentId    String?
  tradeId      String?
  entryType    LedgerEntryType @default(ADJUSTMENT)
  reason        String
  amountKrw     BigInt
  occurredAt    DateTime        @default(now())

  @@index([transactionId, occurredAt])
  @@index([tradeId, occurredAt])
  @@unique([paymentId, entryType])
}

model ChatRoom {
  id           String            @id @default(cuid())
  productId    String
  buyerId      String
  sellerId     String
  product      Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  buyer        User              @relation("ChatBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller       User              @relation("ChatSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  participants ChatParticipant[]
  messages     ChatMessage[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([productId, buyerId, sellerId])
  @@index([buyerId, updatedAt])
  @@index([sellerId, updatedAt])
}

model ChatParticipant {
  chatRoomId String
  userId     String
  joinedAt   DateTime @default(now())
  lastReadAt DateTime?
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatRoomId, userId])
  @@index([userId, lastReadAt])
}

model ChatMessage {
  id         String   @id @default(cuid())
  chatRoomId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  author     User     @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([chatRoomId, createdAt])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id         String           @id @default(cuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     String
  detail     String?
  status     ReportStatus     @default(RECEIVED)
  createdAt  DateTime         @default(now())
  reporter   User             @relation(fields: [reporterId], references: [id], onDelete: Restrict)

  @@unique([reporterId, targetType, targetId])
  @@index([targetType, targetId, createdAt])
  @@index([reporterId, createdAt])
}

model Trade {
  id            String         @id @default(cuid())
  productId     String
  buyerId       String
  sellerId      String
  priceKrw      BigInt
  status        TradeStatus    @default(REQUESTED)
  rejectedAt    DateTime?
  deliveredAt   DateTime?
  autoConfirmAt DateTime?
  confirmedAt   DateTime?
  disputedAt    DateTime?
  cancelledAt   DateTime?
  reason        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  buyer         User           @relation("TradeBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller        User           @relation("TradeSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  history       TradeHistory[]
  payment       Payment?

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([productId, status])
  @@index([status, autoConfirmAt])
}

model TradeHistory {
  id         String      @id @default(cuid())
  tradeId    String
  actorId    String?
  fromStatus TradeStatus?
  toStatus   TradeStatus
  reason     String?
  occurredAt DateTime    @default(now())
  trade      Trade       @relation(fields: [tradeId], references: [id], onDelete: Restrict)

  @@index([tradeId, occurredAt])
}

model Payment {
  id                  String             @id @default(cuid())
  tradeId             String             @unique
  orderId             String             @unique
  paymentKey          String?            @unique
  amountKrw           BigInt
  status              PaymentStatus      @default(READY)
  settlementStatus    SettlementStatus   @default(HOLD)
  methodMasked        String?
  lastWebhookSequence Int                @default(0)
  approvedAt          DateTime?
  cancelledAt         DateTime?
  refundedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  trade               Trade              @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  operations          PaymentOperation[]
  webhooks             PaymentWebhook[]

  @@index([status, updatedAt])
  @@index([settlementStatus, updatedAt])
}

model PaymentOperation {
  id             String        @id @default(cuid())
  paymentId      String
  idempotencyKey String        @unique
  action         PaymentAction
  requestHash    String
  responseStatus Int
  response       Json
  createdAt      DateTime      @default(now())
  payment        Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
}

model PaymentWebhook {
  id               String                  @id @default(cuid())
  paymentId        String?
  transmissionId   String                  @unique
  eventType        String
  eventStatus      String
  sequence         Int
  rawBody          String
  processingStatus WebhookProcessingStatus @default(RECEIVED)
  failureCode      String?
  receivedAt       DateTime                @default(now())
  processedAt      DateTime?
  payment          Payment?                @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, sequence])
  @@index([processingStatus, receivedAt])
}
