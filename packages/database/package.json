{
  "name": "@gamja/database",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node dist/prisma/seed.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.0.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@gamja/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.30.0",
    "prisma": "^7.0.0",
    "typescript": "^6.0.0-dev.20260715",
    "vitest": "^3.2.0"
  },
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "type": "module"
}
